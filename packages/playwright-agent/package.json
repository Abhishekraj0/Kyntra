{
  "name": "@kyntra/playwright-agent",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Kyntra Playwright integration for E2E test generation and frontend correlation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kyntra/shared": "workspace:*",
    "@playwright/test": "^1.43.0",
    "playwright": "^1.43.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  }
}
