# ============================================
# KYNTRA — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- Database ----
DATABASE_URL="postgresql://kyntra:kyntra_dev@localhost:5432/kyntra"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- AI ----
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ---- Services ----
COLLECTOR_PORT=3001
ANALYZER_PORT=3002
GATEWAY_PORT=3000
DASHBOARD_PORT=3003

COLLECTOR_URL="http://localhost:3001"
ANALYZER_URL="http://localhost:3002"
GATEWAY_URL="http://localhost:3000"

# ---- Auth ----
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_EXPIRY="7d"

# ---- GitHub Integration ----
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Azure DevOps Integration ----
# Configured per-project in project settings JSON:
#   azureDevopsRepoUrl, azureDevopsToken, azureDevopsWebhookSecret

# ---- Bitbucket Integration ----
# Configured per-project in project settings JSON:
#   bitbucketRepoFullName (workspace/repo), bitbucketClientId, bitbucketClientSecret, bitbucketWebhookSecret

# ---- Dashboard (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# ---- Feature Flags ----
ENABLE_AI_REVIEWS=true
ENABLE_TEST_GENERATION=true
ENABLE_GITHUB_INTEGRATION=false

# ---- Notifications (M6) ----
SLACK_WEBHOOK_URL=""
PAGERDUTY_INTEGRATION_KEY=""
TEAMS_WEBHOOK_URL=""
DASHBOARD_URL="http://localhost:3003"

# ---- Kyntra MCP Server (M6) ----
KYNTRA_GATEWAY_URL="http://localhost:3000"
KYNTRA_API_KEY=""
KYNTRA_PROJECT_ID=""

# ---- Observability ----
LOG_LEVEL="info"
OTEL_SERVICE_NAME="kyntra"
OTEL_EXPORTER_OTLP_ENDPOINT=""
